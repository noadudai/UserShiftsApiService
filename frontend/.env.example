# frontend environment variables
# Place this file at frontend/front/.env (next to package.json) and fill in the values.

# Auth0 tenant domain, e.g. https://dev-xxxx.us.auth0.com/
VITE_AUTH0DOMAIN=

# Auth0 SPA application Client ID
VITE_AUTH0CLIENTID=

# Auth0 API audience identifier, e.g. https://UsersShiftsApi/
VITE_AUTH0AUDIENCE=

# URL Auth0 redirects back to after login (must match Auth0 Allowed Callback URLs)
VITE_HOMEPAGEURL=http://localhost:5173

# Base URL of the C# API (no trailing slash)
VITE_BACKEND_BASE_URL=http://localhost:5029
