# backend-csharp environment variables
# For local dev, set these via dotnet user-secrets (recommended) or a .env file.
# For Docker, these are loaded from the root .env via docker-compose env_file.

# Auth0 tenant domain, e.g. https://dev-xxxx.us.auth0.com/
Auth0__Domain=

# Auth0 API audience identifier
Auth0__Audience=https://UsersShiftsApi/

# Shared HMAC secret — must match HMAC_SECRET set in the Auth0 Post User Registration action
Auth0__HMAC_SECRET=

# PostgreSQL connection string
# Local dev (dotnet run):  Host=localhost;Port=5432;Database=shiftsusers;Username=postgres;Password=postgres
# Docker compose:          Host=postgres;Port=5432;Database=shiftsusers;Username=postgres;Password=postgres
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=shiftsusers;Username=postgres;Password=postgres

# Frontend origin used for the CORS policy
FrontUrl=http://localhost:5173
