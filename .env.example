# =============================================================
# Scheduling App — environment variables
# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.
# =============================================================

# --- frontend (frontend/front/.env) ---
VITE_AUTH0DOMAIN=
VITE_AUTH0CLIENTID=
VITE_AUTH0AUDIENCE=
VITE_HOMEPAGEURL=http://localhost:5173
VITE_BACKEND_BASE_URL=http://localhost:5029

# --- backend-csharp ---
# Auth0 tenant domain, e.g. https://dev-xxxx.us.auth0.com/
Auth0__Domain=
# Auth0 API audience identifier
Auth0__Audience=https://UsersShiftsApi/
# Shared HMAC secret — must match the HMAC_SECRET secret set in the Auth0 Action
Auth0__HMAC_SECRET=
# PostgreSQL connection string (matches postgres service below)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=shiftsusers;Username=postgres;Password=postgres
# Frontend origin for CORS
FrontUrl=http://localhost:5173

# --- postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shiftsusers
